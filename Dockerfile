# Generated by Autore CLI — Multi-stage Python Dockerfile (Auto-detect entrypoint)
FROM python:3.12-slim AS test
WORKDIR /app
COPY . .
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; \
    elif [ -f pyproject.toml ]; then pip install --no-cache-dir .; fi
RUN if find . -maxdepth 3 \( -name 'test_*.py' -o -name '*_test.py' \) | grep -q .; then \
        python -m unittest discover -v; \
    else \
        python -m compileall -q .; \
    fi

FROM python:3.12-slim
WORKDIR /app
COPY --from=test /usr/local /usr/local
COPY --from=test /app /app
# Tambal paket OS dari repo security: base `python:3.12-slim` membawa apt 3.0.3
# dengan CVE-2026-109518 (perbaikan 3.0.4 ada di trixie-security), dan gerbang
# Trivy memblokir image karena celah itu punya versi perbaikan. Stage inilah yang
# dikirim, jadi menambal di stage `test` tidak menolong. Tanpa pin versi supaya
# perbaikan berikutnya ikut terbawa tanpa menyunting berkas ini lagi.
# Cache-bust dari pipeline: nilai ARG ini berubah tiap build, jadi cache
# layer apt batal dan apt-get upgrade benar-benar dijalankan ulang.
ARG AUTORE_APT_REFRESH=0
RUN apt-get update \
    && apt-get -y upgrade \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --no-create-home appuser
USER appuser
EXPOSE 8000
CMD ["sh", "-c", "if [ -f app.py ]; then exec python app.py; elif [ -f main.py ]; then exec python main.py; elif [ -f run.py ]; then exec python run.py; elif [ -f manage.py ]; then exec python manage.py runserver 0.0.0.0:8000; else echo 'Entrypoint Python tidak ditemukan (app.py / main.py / run.py / manage.py)' >&2; exit 1; fi"]
